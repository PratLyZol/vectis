# Vectis environment. Copy to .env (git-ignored). Never commit real values.

# Arc testnet wallet: deployer, oracle poster and executor (testnet only).
DEPLOYER_PRIVATE_KEY=

# Arc testnet
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_WS_URL=wss://rpc.testnet.arc.io

# Gemini. Public market data needs no auth.
GEMINI_PUBLIC_BASE=https://api.gemini.com
GEMINI_TRADE_BASE=https://api.sandbox.gemini.com
# Leave both empty to run the keeper in mock mode (fills simulated at the oracle price).
GEMINI_API_KEY=
GEMINI_API_SECRET=

# Keeper tuning
KEEPER_MARKET_COUNT=8
KEEPER_POLL_MS=10000
KEEPER_HEARTBEAT_MS=45000

# QuickNode Streams
QUICKNODE_API_KEY=
# 32+ char secret used to verify stream webhook signatures
QN_STREAM_SECURITY_TOKEN=
# Public URL of the deployed web app (set after the Vercel deploy)
VECTIS_APP_URL=
# Neon Postgres for stream events (web only)
DATABASE_URL=

# Server only. Base URL of Gemini's public market-data API. No key or secret is used by the web app.
GEMINI_PUBLIC_BASE=https://api.gemini.com

# Server only. Neon Postgres connection string holding the stream_events table.
DATABASE_URL=

# Server only. Security token of the QuickNode stream that POSTs to /api/qn-stream.
QN_STREAM_SECURITY_TOKEN=
